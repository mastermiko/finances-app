{
  "name": "finances-app",
  "version": "1.0.0",
  "private": true,
  "description": "Application local-first de gestion de finances personnelles (PWA, sans compte ni serveur).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/app/main.tsx",
    "./src/io/workers/io.worker.ts",
    "./src/features/analytics/echarts.ts",
    "./src/domain/model/schemas.ts"
  ],
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run schema && tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "size": "node scripts/check-bundle-size.mjs",
    "lhci": "pnpm dlx @lhci/cli@0.15.1 autorun",
    "schema": "tsx --tsconfig tsconfig.node.json scripts/generate-json-schema.ts",
    "fixture:demo": "tsx --tsconfig tsconfig.node.json scripts/generate-demo-data.ts",
    "fixture:workbook": "python3 scripts/generate-workbook-fixture.py",
    "i18n:check": "tsx --tsconfig tsconfig.node.json scripts/check-i18n.ts",
    "licenses": "node scripts/supply-chain.mjs licenses",
    "sbom": "node scripts/supply-chain.mjs sbom",
    "package:zip": "node scripts/package-zip.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "changeset": "changeset",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "3.14.22",
    "comlink": "4.4.2",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "echarts": "6.1.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "lucide-react": "1.61.0",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-intl": "12.1.5",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@formatjs/icu-messageformat-parser": "2.11.4",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "fast-check": "4.10.2",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "jsdom": "28.1.0",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "storybook": "10.6.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "ignoredBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
